{
  "manifest_version": 3,
  "name": "中通客服智助·问题件桥接",
  "version": "0.1.0",
  "description": "问题件回复桥接：读列表、填回复弹窗、回传结果。决策全在服务端（模板/规则/AI审核/审计），插件只执行。",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://*.zto56.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://datahub-portlet.zto56.com/*", "https://ws.zto56.com/*"],
      "js": ["content/main.js"],
      "run_at": "document_idle"
    }
  ]
}
